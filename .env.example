# Copy this file to `.env` and fill in real values. `.env` is git-ignored — never commit it.
# On Coolify, set the same variables in the application's Environment Variables page instead.

# Postgres password. Use letters and digits only (it is placed inside a database URL).
POSTGRES_PASSWORD=change-me-letters-and-digits

# Signs login tokens. At least 32 random characters; changing it signs everyone out.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Vultr Serverless Inference API key (Vultr dashboard → Serverless Inference). Without it the
# AI features answer 503; everything else works.
LLM_API_KEY=
# Optional: model name (default glm-5.3-flash)
# LLM_MODEL=glm-5.3-flash

# Email through Resend (resend.com → API Keys, "Sending access"). Without a key, approved emails
# are marked failed with "not configured"; everything else works.
RESEND_API_KEY=
# Optional sender. onboarding@resend.dev works without your own domain.
# EMAIL_FROM=UNIFY SUITE <onboarding@resend.dev>
# Demo safety: send every email to this one inbox instead of the real recipient
# (without a verified domain, Resend only delivers to your own account address).
EMAIL_REDIRECT_TO=

# Quarterly sales target shown on the dashboard gauge (whole currency units).
# SALES_QUARTER_TARGET=250000
# SALES_TARGET_CURRENCY=USD

# Python log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
