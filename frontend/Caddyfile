# Serves the built React app and forwards /api/* to the backend container on the internal network.
# HTTPS and the public domain are handled by Coolify's proxy in front of this container.
{
	admin off
	auto_https off
}

:80 {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
